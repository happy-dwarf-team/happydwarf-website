---
// The document shell of every page: family and site styles, the head tags, the header and
// the footer (docs/spec.md, sections 3 and 6). The page's content goes into <main>.
import '../styles/forge-family.css';
import '../styles/site.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	/** The page title without the site name. */
	title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Head title={title} />
	</head>
	<body>
		<Header />
		<main id="main" class="wrap">
			<slot />
		</main>
		<Footer />
	</body>
</html>
