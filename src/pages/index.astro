---
// Placeholder until the home page is built (docs/spec.md, section 3). It lists the project
// data with the family styles only, so every build already fetches and checks it.
import Base from '../layouts/Base.astro';
import { getProjectGroups } from '../lib/projects';

const groups = await getProjectGroups();
---

<Base title="Tools and mods for Europa Universalis IV">
	<main>
		<h1>Happy Dwarf Team</h1>
		<p>
			Open-source tools and mods for Europa Universalis IV. This site is being built; the
			projects are on <a href="https://github.com/happy-dwarf-team">GitHub</a>.
		</p>
		{
			groups.map((group) => (
				<section aria-labelledby={group.id}>
					<h2 id={group.id}>{group.title}</h2>
					<p>
						{group.intro} {group.count} {group.unit}.
					</p>
					<ul>
						{group.rows.map((row) => (
							<li>
								<a href={row.primary.href}>{row.name}</a>
								{row.badge && ` (${row.badge.kind === 'version' ? `v${row.badge.version}` : row.badge.label})`}
								: {row.summary}
							</li>
						))}
					</ul>
					{group.catalog && (
						<p>
							<a href={group.catalog.href}>All {group.catalog.count} plugins in the Anvil catalog</a>
						</p>
					)}
				</section>
			))
		}
		<p>
			Happy Dwarf Team projects are unofficial community projects, not affiliated with or
			endorsed by Paradox Interactive.
		</p>
	</main>
</Base>
