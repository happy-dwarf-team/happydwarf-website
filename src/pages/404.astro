---
// The 404 page (docs/spec.md, section 3.2; DESIGN.md, "404 block"). GitHub Pages serves it
// for every missing URL with status 404. Header and footer come from Base.
import Base from '../layouts/Base.astro';
import { GROUPS } from '../lib/projects';
import { url } from '../lib/url';
---

<Base title="Page not found">
	<section class="not-found" aria-labelledby="not-found-heading">
		<p class="code" aria-hidden="true">404</p>
		<h1 id="not-found-heading">This tunnel was never dug.</h1>
		<p class="line">The page you followed does not exist. The projects are all on the home page.</p>
		<a class="button" href={url('/')}>
			Back to happydwarf.dev <span class="arrow" aria-hidden="true">→</span>
		</a>
		<ul aria-label="Project groups">
			{
				GROUPS.map(({ id, title }) => (
					<li>
						<a class="link" href={`${url('/')}#${id}`}>
							{title}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		max-width: 40rem;
		padding-block: 5rem 2rem;
	}

	.code {
		color: var(--forge-accent);
		font: 700 clamp(3.5rem, 2rem + 8vw, 6.5rem)/1 var(--forge-font-mono);
		letter-spacing: -0.04em;
	}

	h1 {
		font-size: 1.6rem;
	}

	.line {
		color: var(--forge-text-muted);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>
